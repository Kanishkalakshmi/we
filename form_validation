<!DOCTYPE html>
<html>
<head>
    <title>Form Validation</title>

    <style>

        body{
            font-family:Arial;
            text-align:center;
            margin-top:50px;
        }

        input{
            padding:10px;
            margin:10px;
            width:250px;
        }

        button{
            padding:10px 20px;
        }

        .error{
            color:red;
        }

    </style>
</head>

<body>

    <h2>Student Mark Form</h2>

    <form onsubmit="return validateForm()">

        <input type="text" id="name" placeholder="Enter Name"><br>

        <input type="number" id="mark1" placeholder="Enter Mark 1"><br>

        <input type="number" id="mark2" placeholder="Enter Mark 2"><br>

        <input type="number" id="mark3" placeholder="Enter Mark 3"><br>

        <button type="submit">Submit</button>

    </form>

    <h3 id="result"></h3>

    <div class="error" id="error"></div>

    <script>

        function validateForm(){

            let name=document.getElementById("name").value;
            let m1=parseInt(document.getElementById("mark1").value);
            let m2=parseInt(document.getElementById("mark2").value);
            let m3=parseInt(document.getElementById("mark3").value);

            let error=document.getElementById("error");

            error.innerHTML="";

            if(name==""){
                error.innerHTML="Name cannot be empty";
                return false;
            }

            if(m1<0 || m1>100 || m2<0 || m2>100 || m3<0 || m3>100){
                error.innerHTML="Marks should be between 0 and 100";
                return false;
            }

            let total=m1+m2+m3;

            document.getElementById("result").innerHTML=
            "Total Marks = "+total;

            return false;
        }

    </script>

</body>
</html>
